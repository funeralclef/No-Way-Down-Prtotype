<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>NoWayDown</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);build/**;builds/**;exports/**;dist/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition=" '$(Configuration)' == 'ExportRelease' or '$(Configuration)' == 'ExportDebug' ">
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
