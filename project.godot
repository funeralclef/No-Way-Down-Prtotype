; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="No Way Down"
config/version="0.1.0"
config/description="Stay on your feet, outmaneuver the horde, and survive the descent."
run/main_scene="res://refuge.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.webp"

[autoload]

GameLocale="*res://GameLocale.cs"
MusicPlayer="*uid://dwgxgvhij3gfx"
CustomizationProfile="*res://CustomizationProfile.cs"
UiAccessibility="*res://UiAccessibility.cs"
UiVisualStyle="*res://UiVisualStyle.cs"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="No Way Down"

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false

